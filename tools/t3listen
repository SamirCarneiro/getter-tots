// answered through `t3ctl answer` on this computer? (t3ctl writes answered-here.json before it responds)
const answeredHere = (id) => { const m = readJSON(HERE, {}) || {}; return !!m[crypto.createHash("sha256").update(String(id)).digest("hex").slice(0, 16)]; };

