}
const die = (code, msg) => { console.error(`${code}: ${msg}`); process.exit(1); };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const readJSON = (f, d) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return d; } };

// ---------- config ----------
// minutes after which an old request is skipped at startup; missing or unreadable means the documented 1440 (a day), 0 turns it off
const staleMinutes = (v) => (v === undefined || v === null || v === "" || !Number.isFinite(+v) || +v < 0 ? 1440 : +v);
function loadConfig() {
