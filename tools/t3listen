// pickThread: the same rules as t3ctl (tests/t3listen.test.js checks they agree): exact id, else an id prefix of 8+ characters,
// else one exact title, else one title containing the text. Several matches: AMBIGUOUS, never a guess
const normT = (s) => String(s).toLowerCase().replace(/\s+/g, " ").trim();
const idLike = (q) => /^[A-Za-z0-9_:-]{8,}$/.test(String(q)); // no whitespace, 8+ chars, colons allowed (thread:project:…, thread:delegated-task:…)
function pickThread(all, q) {
  q = String(q); const list = (m) => m.slice(0, 8).map((t) => `${t.id}  ${t.title}`).join("\n  ");
  const amb = (m) => { throw new Error(`AMBIGUOUS: ${m.length} threads match "${q}". Pass the full id:\n  ${list(m)}`); };
  const exact = all.find((t) => t.id === q); if (exact) return exact;
  if (q.length >= 8) { const pre = all.filter((t) => String(t.id).startsWith(q)); if (pre.length === 1) return pre[0]; if (pre.length > 1) amb(pre); }
  const same = all.filter((t) => normT(t.title || "") === normT(q)); if (same.length === 1) return same[0]; if (same.length > 1) amb(same);
  const m = all.filter((t) => normT(t.title || "").includes(normT(q)));
  if (!m.length) throw new Error(`NOT_FOUND: no thread matches "${q}"${/^[0-9a-f-]{1,7}$/i.test(q) ? " (an id prefix needs 8 or more characters)" : ""}`);
  if (m.length > 1) amb(m);
