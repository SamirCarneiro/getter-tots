    if (process.stdin.isTTY && lines.length === 1) process.stderr.write(/^https?:\/\//.test(t) ? "  got the URL. Now line 2 (Authorization: ...):\n" : "  that doesn't start with https:// - run setup again and paste the Webhook URL first.\n");
