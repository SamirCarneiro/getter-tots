  const tmp = CONF + ".part"; fs.writeFileSync(tmp, JSON.stringify(c, null, 1) + "\n", { mode: 0o600 }); fs.renameSync(tmp, CONF); lockDown(CONF);
  console.log(`saved listen.json (url set, ${Object.keys(headers).length} header(s), machine "${c.machine}", approvals ${c.approvals ? "on" : "off"}). Test it with: node "${path.join(DIR, "t3listen")}" test`);
}

// ---------- T3 connection (same discovery as t3ctl) ----------
function t3Dir() {
  for (let v of [process.env.GETTER_HOME, process.env.T3_HOME, process.env.T3CODE_HOME]) {
    v = (v || "").trim(); if (!v) continue;
    if (v === "~" || /^~[\\/]/.test(v)) v = path.join(HOME, v.slice(1));
    v = path.resolve(v);
    return fs.existsSync(path.join(v, "server-runtime.json")) || fs.existsSync(path.join(v, "statev2.sqlite")) || /^(userdata|dev)$/i.test(path.basename(v)) ? v : path.join(v, "userdata");
  }
  return path.join(HOME, ".getter-code", "userdata");
}
function endpoint() {
  const rt = readJSON(path.join(t3Dir(), "server-runtime.json"), null); if (!rt) return null;
  const h = rt.host; const base = `http://${!h || h === "0.0.0.0" || h === "::" ? "127.0.0.1" : h.includes(":") ? `[${h}]` : h}:${rt.port}`;
  let token = ""; try { token = fs.readFileSync(path.join(DIR, "token"), "utf8").trim(); } catch {}
  return { base, H: { Authorization: "Bearer " + token, "x-t3-orchestration-protocol": "2" }, token };
}
async function threadSnap(ep, id) {
  const r = await fetch(`${ep.base}/api/orchestration/threads/${encodeURIComponent(id)}`, { headers: ep.H });
  if (r.status === 404) return null; if (!r.ok) throw new Error(`thread fetch HTTP ${r.status}`); return (await r.json()).projection;
}

// ---------- request details (same shape as `t3ctl pending --json`) ----------
const SKIP_KINDS = new Set(["dynamic_tool_call", "auth_refresh"]);
// short context for the chat: the thread's last assistant text before the question (else the last user prompt), redacted and trimmed
// SECRET_KEYS: word for word the same as scripts/scan-private.py (tests/install_test.py checks)
const SECRET_KEYS = String.raw`sk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}|(?:sk|rk)_[a-z]+_[A-Za-z0-9_]{16,}|whsec_[A-Za-z0-9+/=_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[abposr]-[A-Za-z0-9-]{10,}|xapp-[A-Za-z0-9-]{10,}|npm_[A-Za-z0-9]{30,}|glpat-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----|https://hooks\.slack\.com/services/[A-Za-z0-9/]+|https://(?:ptb\.|canary\.)?discord(?:app)?\.com/api/webhooks/\d+/[\w-]+`;
const RED = new RegExp(`(${SECRET_KEYS}|eyJ[A-Za-z0-9_-]{15,}\\.[A-Za-z0-9_.-]+|(?:api[_-]?key|token|secret|password)\\s*[:=]\\s*\\S{8,})`, "gi");
const clean = (t) => { t = String(t).replace(RED, "[redacted]"); return HOME && HOME.length > 1 ? t.split(HOME).join("~") : t; };
// every text field of an event (questions, option labels, approval prompt, title, answers, errors) is redacted before it is sent, logged or previewed; ids are kept
function cleanEvent(v, k = "") {
  if (typeof v === "string") return /(^id$|Id$)/.test(k) ? v : clean(v);
  if (Array.isArray(v)) return v.map((x) => cleanEvent(x, k));
