  const i = argv.indexOf(f); return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith("--") ? argv[i + 1] : undefined; };
const DRY = flag("--dry-run"), ONCE = flag("--once"), TOLOG = flag("--log"), VERBOSE = flag("--verbose");
function log(...a) {
  const line = `${new Date().toISOString()} ${a.join(" ")}`;
  if (!TOLOG) return console.log(line);
