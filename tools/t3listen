}
const trim = (t, n) => { t = clean(t).replace(/\s+/g, " ").trim(); return t.length > n ? t.slice(0, n - 1).trimEnd() + "…" : t; };
function contextOf(p, it) {
  const items = p.turnItems || [], end = it ? items.indexOf(it) : items.length; let user = null;
  for (let i = (end < 0 ? items.length : end) - 1; i >= 0; i--) {
    const x = items[i], role = String(x.role || x.kind || x.type || ""), text = x.text ?? x.content ?? (x.message && x.message.text);
    if (typeof text !== "string" || !text.trim() || !/user|assistant|message/i.test(role)) continue;
