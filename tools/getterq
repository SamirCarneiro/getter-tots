#!/usr/bin/env node
// Getter Tots read-only queries, using the same explicit home as getterctl.
const { spawnSync } = require("child_process"), path = require("path"), os = require("os");
let argv = process.argv.slice(2);
// The PowerShell launcher sends JSON as ASCII so native argument quoting cannot change it.
if (argv[0] === "--getter-args-base64") {
  try {
    const decoded = JSON.parse(Buffer.from(argv[1] || "", "base64").toString("utf8"));
    if (argv.length !== 2 || !Array.isArray(decoded) || decoded.some((v) => typeof v !== "string")) throw new Error("invalid arguments");
    argv = decoded;
  } catch { console.error("USAGE: invalid encoded Getter arguments"); process.exit(2); }
}
const args = [];
let home;
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "--getter-home") {
    home = argv[++i];
    if (!home || !home.trim() || home.startsWith("--")) { console.error("USAGE: --getter-home needs a folder"); process.exit(2); }
  } else if (argv[i].startsWith("--getter-home=")) {
    home = argv[i].slice("--getter-home=".length);
    if (!home.trim()) { console.error("USAGE: --getter-home needs a folder"); process.exit(2); }
  } else args.push(argv[i]);
}
const env = { ...process.env, GETTER_HOME: home || [process.env.GETTER_HOME, process.env.T3_HOME, process.env.T3CODE_HOME].find((v) => v && v.trim()) || path.join(os.homedir(), ".getter-code") };
const python = process.env.GETTER_PYTHON || (process.platform === "win32" ? "py" : "python3");
const prefix = !process.env.GETTER_PYTHON && process.platform === "win32" ? ["-3"] : [];
const result = spawnSync(python, [...prefix, path.join(__dirname, "t3q.py"), ...args], { stdio: "inherit", env });
if (result.error) { console.error("GETTER_PYTHON_UNAVAILABLE: install Python 3.8+ or set GETTER_PYTHON to its executable. " + result.error.message); process.exit(2); }
process.exit(result.status === null ? 1 : result.status);
